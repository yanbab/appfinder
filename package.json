{
  "name": "appfinder",
  "productName": "AppFinder",
  "version": "0.9.7",
  "description": "App store for the Homebrew package manager",
  "author": "yanbab",
  "license": "MIT",
  "main": "dist/vite-main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanbab/appfinder.git"
  },
  "bugs": {
    "url": "https://github.com/yanbab/appfinder/issues"
  },
  "homepage": "https://github.com/yanbab/appfinder#readme",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build:react && npm run build:main && electron .",
    "build": "npm run build:react && npm run build:main && electron-builder build --mac",
    "build:intel": "npm run build:react && npm run build:main && electron-builder build --mac --x64",
    "build:main": "vite build --config src/main/vite.main.config.mjs",
    "build:react": "vite build --config src/renderer/vite.config.mjs",
    "test": "node --test 'test/**/*.test.js'",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "casks",
    "homebrew",
    "electron",
    "appstore",
    "applications"
  ],
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "clsx": "^2.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "org.yanbab.appfinder",
    "mac": {
      "icon": "docs/assets/icon.svg",
      "category": "public.app-category.utilities",
      "identity": null,
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "minimumSystemVersion": "13.0.0"
    },
    "directories": {
      "output": "dist/electron-builder"
    },
    "files": [
      "dist/vite-main/**/*",
      "dist/vite-renderer/**/*",
      "locales/**/*",
      "data/**/*",
      "package.json"
    ]
  }
}