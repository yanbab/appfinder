{
  "name": "appfinder",
  "productName": "AppFinder",
  "version": "0.9.5",
  "description": "App store for the Homebrew package manager",
  "author": "yanbab",
  "license": "MIT",
  "main": "src/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanbab/appfinder.git"
  },
  "bugs": {
    "url": "https://github.com/yanbab/appfinder/issues"
  },
  "homepage": "https://github.com/yanbab/appfinder#readme",
  "scripts": {
    "dev": "node src/scripts/dev.mjs",
    "start": "npm run build:react && electron .",
    "build": "npm run build:react && electron-builder build --mac",
    "build:react": "vite build --config src/renderer/vite.config.mjs",
    "watch:react": "vite build --watch --config src/renderer/vite.config.mjs",
    "dev:react": "vite --config src/renderer/vite.config.mjs",
    "fetch": "cd src/scripts && bash fetch-casks.sh",
    "clean": "rm -rf ./cache ./dist $HOME/.config/appfinder \"$HOME/Library/Application Support/AppFinder\"",
    "release": "node src/scripts/release.js"
  },
  "keywords": [
    "casks",
    "homebrew",
    "electron",
    "appstore",
    "applications"
  ],
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "electron-drag-click": "^1.0.6",
    "lucide-react": "^1.48.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xterm": "^5.3.0"
  },
  "build": {
    "appId": "org.yanbab.appfinder",
    "mac": {
      "icon": "docs/assets/icon.svg",
      "category": "public.app-category.utilities",
      "identity": null,
      "target": {
        "target": "default",
        "arch": [
          "x64",
          "arm64"
        ]
      },
      "minimumSystemVersion": "13.0.0"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  }
}
